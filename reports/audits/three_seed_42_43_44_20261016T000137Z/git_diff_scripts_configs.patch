-def middle_slices(array: np.ndarray) -> dict[str, np.ndarray]:
-    return {
-        "axis0": array[array.shape[0] // 2, :, :],
-        "axis1": array[:, array.shape[1] // 2, :],
-        "axis2": array[:, :, array.shape[2] // 2],
-    }
